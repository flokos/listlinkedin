# Copy to `.env`. Development works without it (compose.yaml has dev defaults);
# production (compose.prod.yaml) requires every value below.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=go.example.com
# Number of reverse proxies in front of the API (used to find the client IP for rate limiting).
# 1 = the bundled nginx. Add one per extra proxy/load balancer in front of it.
DJANGO_NUM_PROXIES=1

POSTGRES_DB=listlinkedin
POSTGRES_USER=listlinkedin
POSTGRES_PASSWORD=change-me

# Base URL used to build absolute public list and short URLs. Never hardcoded in code.
PUBLIC_BASE_URL=https://go.example.com

# Comma-separated hosts links may not point to (subdomains included). Applies to existing
# links too: their short URLs answer 410. This service's own host is always blocked.
BLOCKED_DESTINATION_HOSTS=

# API rate limits per client IP (DRF rate syntax). Keep the defaults in production; the
# end-to-end suite raises them for its throwaway stack.
# THROTTLE_LIST_CREATE=30/hour
# THROTTLE_LIST_MANAGE=600/hour
# THROTTLE_ACCOUNT=300/hour  (per signed-in user: profile changes)
# THROTTLE_UPLOAD=120/hour  (per signed-in user: list images and link icons)
# THROTTLE_RESTORE=120/hour  (restoring a list to an earlier revision)
# THROTTLE_METADATA_REFRESH=60/hour  (per signed-in user: fetching a link's details again)
# THROTTLE_DIRECTORY=600/hour  (per client IP: searching public lists and groups)
# THROTTLE_REPORT=10/hour  (per user or client IP: reports to the operator)

# Outgoing mail for account verification and password-reset links (production uses SMTP;
# development prints mail to the api logs). DEFAULT_FROM_EMAIL defaults to
# "listlinkedin <no-reply@{PUBLIC_BASE_URL host}>".
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
# DEFAULT_FROM_EMAIL=listlinkedin <no-reply@go.example.com>
# Mail is sent during the request; a relay slower than this many seconds fails it.
# EMAIL_TIMEOUT=10
# Where reports of abuse go (docs/v2/13-SECURITY.md#moderation). Set it in production:
# without it, reports are only logged.
MODERATION_EMAIL=moderation@go.example.com

# PostgreSQL timeouts for the API (production only). The one-shot migrate service runs
# with DB_STATEMENT_TIMEOUT=0 so long data migrations aren't cut off.
# DB_LOCK_TIMEOUT=5s
# DB_STATEMENT_TIMEOUT=20s

# Log lines are JSON objects in production; `text` keeps the development format.
# LOG_FORMAT=json

# Gunicorn worker processes (production only).
WEB_CONCURRENCY=3

# Background tasks (the `worker` service). Each replica runs one task at a time.
# WORKER_REPLICAS=2
# Fetching titles, descriptions and icons of links (from task 7.3). `false` turns it off,
# e.g. for a deployment that must never contact other sites.
# METADATA_FETCH_ENABLED=true
# Extra address ranges (comma-separated CIDRs) the fetcher must never connect to, on top of
# the built-in private, loopback, link-local and cloud-metadata ranges. Use it for internal
# services on public addresses, e.g. your company's range. It can only add, never unblock.
# FETCH_BLOCKED_NETWORKS=203.0.113.0/24

# nginx (production only). SERVER_NAME is the public hostname from PUBLIC_BASE_URL.
SERVER_NAME=go.example.com
# Directory holding fullchain.pem and privkey.pem (e.g. /etc/letsencrypt/live/<host>).
TLS_CERT_DIR=./deploy/certs
# Webroot for Let's Encrypt HTTP-01 challenges (certbot --webroot -w <this dir>).
ACME_WEBROOT=./deploy/acme
HTTP_PORT=80
HTTPS_PORT=443
# Maintenance page: `touch deploy/maintenance/on` shows it, deleting the file ends it.
# MAINTENANCE_DIR=./deploy/maintenance
