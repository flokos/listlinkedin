# TLS reverse proxy: serves the Vue app (built into this image from frontend/) and forwards
# the API to Django. The nginx image renders this template at startup,
# substituting ${SERVER_NAME} only (NGINX_ENVSUBST_FILTER); $nginx_variables are untouched.

server_tokens off;

# nginx's default access-log format plus the request id ($request_id), which is also sent to
# Django as X-Request-ID and appears in its logs (docs/v2/14-INFRASTRUCTURE.md#health-checks-and-observability).
log_format requests '$remote_addr - $remote_user [$time_local] "$request" '
                    '$status $body_bytes_sent "$http_referer" "$http_user_agent" '
                    'request_id=$request_id';

# Requests carry a title and a URL; Django rejects bodies over 16 KB with a JSON 413.
# This only stops anything far larger before it reaches a worker. The image upload routes
# get 3 MB below (Django: 2 MB per file).
client_max_body_size 32k;

# nginx buffers request bodies before proxying (proxy_request_buffering is on by default),
# so slow clients tie up nginx connections, not Gunicorn's few sync workers.
client_header_timeout 10s;
client_body_timeout 10s;

# The API's address is looked up when a request needs it (Docker's DNS, cached 10 s), not
# once at startup: an upgrade that recreates the api container may give it a new address, and
# nginx can start, for the maintenance page, while no api exists (task 9.5).
resolver 127.0.0.11 valid=10s ipv6=off;

# Maintenance mode: while the file /srv/maintenance/on exists (deploy/maintenance/on on the
# host), every request gets the static 503 page. `touch` it to start, delete it to end; nginx
# checks on every request, so no reload is needed (docs/deployment.md#maintenance-mode).

# Vite fingerprints everything under /assets/, so those files never change; index.html and
# other public files are revalidated so a deploy is picked up on the next load.
map $uri $static_cache_control {
    ~^/assets/  "public, max-age=31536000, immutable";
    default     "no-cache";
}

# Unknown hosts: drop plain HTTP connections and refuse TLS handshakes for other names.
server {
    listen 80 default_server;
    listen 443 ssl default_server;
    ssl_reject_handshake on;
    return 444;
}

server {
    listen 80;
    server_name ${SERVER_NAME};

    # Let's Encrypt HTTP-01 challenges (certbot --webroot -w <ACME_WEBROOT>).
    location /.well-known/acme-challenge/ {
        root /var/www/acme;
    }

    # API and account requests over plain HTTP are refused, not redirected: a client that
    # sent a token or password in the clear must notice, rather than silently succeed after
    # a redirect (ASVS V4.1.2). Browsers are on HTTPS anyway (HSTS).
    location ~ ^/(api|_allauth)/ {
        return 403;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${SERVER_NAME};
    access_log /var/log/nginx/access.log requests;

    ssl_certificate /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;

    # Mozilla "intermediate" profile.
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:TLS:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;
    # HSTS is sent by Django (SECURE_HSTS_SECONDS), so it is not repeated here.

    # A variable makes proxy_pass resolve the name per request, through the resolver above.
    set $api_upstream api:8000;

    # The maintenance page, for every 503 nginx returns itself (not for the API's own 503s,
    # which pass through unchanged).
    error_page 503 /maintenance.html;
    location = /maintenance.html {
        internal;
        root /srv/maintenance;
        charset utf-8;
        add_header Retry-After 600 always;
        add_header Cache-Control no-store always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy no-referrer always;
        add_header X-Robots-Tag "noindex, nofollow" always;
        add_header Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; frame-ancestors 'none'" always;
    }

    # Internal-only deployment: uncomment and list your office/VPN ranges.
    # allow 10.0.0.0/8;
    # allow 192.168.0.0/16;
    # deny all;

    # Image uploads: the only larger request bodies (docs/v2/09-API-DESIGN.md#uploads).
    # Regex locations match in order, so this one must come before the general API one.
    location ~ ^/api/v2/(lists/[^/]+/(image|links/[^/]+/icon)|groups/[^/]+/image)/$ {
        client_max_body_size 3m;
        if (-f /srv/maintenance/on) {
            return 503;
        }
        proxy_pass http://$api_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Request-ID $request_id;
        proxy_connect_timeout 5s;
        proxy_read_timeout 35s;
        proxy_send_timeout 35s;
    }

    # Uploaded images, re-encoded to WebP by the API and named by their SHA-256, so they never
    # change (docs/v2/13-SECURITY.md#media). Served as inert files: only `.webp` gets an image
    # type, nothing is sniffed, and a sandbox CSP stops anything opened as a document.
    location /media/ {
        if (-f /srv/maintenance/on) {
            return 503;
        }
        alias /srv/media/;
        types { image/webp webp; }
        default_type application/octet-stream;
        # Not `always`: a 404 must not be cached, since a deleted file can come back.
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options nosniff always;
        add_header Content-Security-Policy "default-src 'none'; sandbox; frame-ancestors 'none'" always;
        add_header Referrer-Policy no-referrer always;
        add_header X-Robots-Tag "noindex, nofollow" always;
    }

    # API, short-URL redirects, account endpoints (allauth) and the health check go to Django.
    location ~ ^/(api|r|_allauth)/|^/healthz$ {
        if (-f /srv/maintenance/on) {
            return 503;
        }
        proxy_pass http://$api_upstream;
        proxy_set_header Host $host;
        # Overwrite rather than append: clients cannot inject fake hops, so the API
        # (DJANGO_NUM_PROXIES=1) always sees the address nginx actually received.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Request-ID $request_id;
        proxy_connect_timeout 5s;
        # A little above Gunicorn's 30 s worker timeout.
        proxy_read_timeout 35s;
        proxy_send_timeout 35s;
    }

    # Everything else is the single-page app, including the public list URLs (/l/{code}).
    # Django sends its own security headers; these mirror them for the app's files.
    location / {
        if (-f /srv/maintenance/on) {
            return 503;
        }
        root /usr/share/nginx/html;
        try_files $uri /index.html;
        # text/html, JavaScript and CSS declare UTF-8 (ASVS V4.1.1).
        charset utf-8;
        charset_types text/css text/javascript application/javascript application/manifest+json;

        add_header Cache-Control $static_cache_control always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options nosniff always;
        # List URLs are capabilities: never leak them in a Referer.
        add_header Referrer-Policy no-referrer always;
        add_header X-Robots-Tag "noindex, nofollow" always;
        # Django sends the same opener policy on its responses (SECURE_CROSS_ORIGIN_OPENER_POLICY).
        add_header Cross-Origin-Opener-Policy same-origin always;
        # The app uses none of these; sharing and the clipboard stay allowed.
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
        # Vuetify injects its theme as a <style> element, hence 'unsafe-inline' for styles.
        add_header Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'" always;

        # Compression only for the app's static files, never for API responses (BREACH).
        gzip on;
        gzip_types text/css application/javascript image/svg+xml;

        # A missing fingerprinted file is a 404, not the app's HTML. Inherits the headers.
        location /assets/ {
            try_files $uri =404;
        }

        # nginx's MIME table has no entry for web app manifests.
        location = /manifest.webmanifest {
            default_type application/manifest+json;
        }
    }
}
