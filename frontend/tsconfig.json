{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    "types": ["vite/client", "node"],
    "noUncheckedIndexedAccess": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "scripts/**/*.ts",
    "vite.config.ts",
    "vitest.config.ts"
  ]
}
