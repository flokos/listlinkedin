{
  "name": "listlinkedin-extension",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.ts",
    "watch": "node scripts/build.ts --watch",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint .",
    "lint:firefox": "addons-linter --self-hosted dist/firefox",
    "pack": "web-ext build --no-config-discovery -o -s dist/chrome -a dist -n listlinkedin-{version}-chrome.zip && web-ext build --no-config-discovery -o -s dist/firefox -a dist -n listlinkedin-{version}-firefox.zip",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.3.7",
    "@types/node": "^26",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "addons-linter": "^10.15.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.13.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.13",
    "web-ext": "^10.8.0"
  }
}
